@page "/registry"
@inject AuthService Auth
@inject ToolService Tools
@inject NavigationManager Nav

@if (Auth.Current == null)
{
    Nav.NavigateTo("/login");
    return;
}

<div>
    <header class="topbar">
        <div class="brand">
            <img src="logo.png" alt="Logo" class="logo-img sm" />
            <div>
                <div class="logo-title">GRAB & LOG</div>
                <div class="logo-sub">TOOL ROOM 5.1</div>
            </div>
        </div>
        <div class="search">
            <span>🔍</span>
            <input type="text" placeholder="Search tool catalog, ID, location..." />
        </div>
        <div class="user">
            <span>@Auth.Current.Name</span>
            <div class="avatar">@Auth.Initials</div>
        </div>
    </header>

    <div class="layout">
        <aside class="sidebar">
            <div class="brand sidebar-brand">
                <img src="logo.png" alt="Logo" class="logo-img sm" />
                <div>
                    <div class="logo-title">GRAB & LOG</div>
                    <div class="logo-sub">TOOL ROOM 5.1</div>
                </div>
            </div>
            <nav>
                <button class="nav-btn" @onclick='() => Nav.NavigateTo("/inventory")'><span>📦</span> Inventory</button>
                <button class="nav-btn" @onclick='() => Nav.NavigateTo("/logs")'><span>📋</span> Activity Logs</button>
                <button class="nav-btn active" @onclick='() => Nav.NavigateTo("/registry")'><span>🚨</span> Control Registry</button>
                <button class="nav-btn" @onclick='() => Nav.NavigateTo("/operators")'><span>👥</span> Operator Registry</button>
            </nav>
            <div class="sidebar-foot">ADMIN MODE · SYSTEM</div>
        </aside>

        <main class="content">
            <div class="registry-head">
                <div>
                    <h2>Control Registry</h2>
                    <p>Manage tools, track status, and resolve overdue items.</p>
                </div>
                <button class="btn-outline">CONSOLE R-1</button>
            </div>

            <div class="critical">
                <div class="critical-text">
                    <strong>⚠ CRITICAL EXCEPTION DETECTED</strong>
                    <span>Tool Hammer (TD-003) is currently overdue. Action required.</span>
                </div>
                <button class="btn-red-sm">ALERT DESK</button>
            </div>

            <div class="stats">
                <div class="stat"><div class="num">@Tools.GetAll().Count</div><div class="lbl">TOTAL REGISTERED</div></div>
                <div class="stat"><div class="num">@Tools.CountByStatus("inuse")</div><div class="lbl">CURRENTLY BORROWED</div></div>
                <div class="stat danger"><div class="num">@Tools.CountByStatus("overdue")</div><div class="lbl">OVERDUE EXCEPTIONS</div></div>
                <div class="stat"><div class="num">@Tools.CountByStatus("disposed")</div><div class="lbl">DISPOSED / RETIRED</div></div>
            </div>

            <div class="table-box">
                <table>
                    <thead>
                        <tr>
                            <th>TOOL</th>
                            <th>BAY / LOCATION</th>
                            <th>STATUS</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Tools.GetAll())
                        {
                            <tr>
                                <td>
                                    <div style="display:flex;align-items:center;gap:8px">
                                        <span>@t.Icon</span>
                                        <div>
                                            <div style="font-weight:500">@t.Name</div>
                                            <div style="font-size:10px;color:var(--muted)">@t.Id</div>
                                        </div>
                                    </div>
                                </td>
                                <td>@t.Location</td>
                                <td><span class="badge @t.Status">@StatusLabel(t.Status)</span></td>
                                <td>
                                    <div class="actions">
                                        <select class="status-select" value="@t.Status" @onchange="e => ChangeStatus(t.Id, e.Value?.ToString() ?? t.Status)">
                                            <option value="available">Available</option>
                                            <option value="inuse">In Use</option>
                                            <option value="overdue">Overdue</option>
                                            <option value="disposed">Disposed</option>
                                        </select>
                                        <button class="btn-sm" @onclick="() => View(t)">View Logs</button>
                                        @if (t.Status != "disposed")
                                        {
                                            <button class="btn-dispose" @onclick="() => OpenDispose(t)">Dispose</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </main>
    </div>
</div>

@if (disposeTool != null)
{
    <div class="modal-backdrop" @onclick="CloseDispose">
        <div class="modal-box" @onclick:stopPropagation>
            <div class="modal-title">
                <span>⚠</span>
                <h3>Dispose @disposeTool.Name (@disposeTool.Id)?</h3>
            </div>
            <p class="modal-desc">This action is permanent and cannot be undone.</p>
            <div class="warn">
                <strong>This action is permanent. The tool will be marked as DISPOSED and removed from the active registry.</strong>
                <ul>
                    <li>Status changes to DISPOSED and stays in the audit log</li>
                    <li>The disposal event is logged</li>
                    <li>The tool is removed from the active catalog registry</li>
                </ul>
            </div>
            <div class="modal-btns">
                <button class="btn-ghost" @onclick="CloseDispose">Cancel</button>
                <button class="btn-red" @onclick="ConfirmDispose">Confirm Disposal</button>
            </div>
        </div>
    </div>
}

@code {
    Tool? disposeTool;

    void ChangeStatus(string id, string status)
    {
        Tools.SetStatus(id, status);
        StateHasChanged();
    }

    void View(Tool t) =>
        // simple alert via JS would need IJSRuntime; for now just no-op or use a small message
        Console.WriteLine($"{t.Name} ({t.Id}) - {t.Status}");

    void OpenDispose(Tool t) => disposeTool = t;
    void CloseDispose() => disposeTool = null;

    void ConfirmDispose()
    {
        if (disposeTool != null)
        {
            Tools.Dispose(disposeTool.Id);
            disposeTool = null;
            StateHasChanged();
        }
    }

    static string StatusLabel(string s) => s switch
    {
        "available" => "AVAILABLE",
        "inuse" => "IN USE",
        "overdue" => "OVERDUE",
        "disposed" => "DISPOSED",
        _ => s.ToUpper()
    };
}
