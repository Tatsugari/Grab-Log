@page "/operators"
@inject AuthService Auth
@inject NavigationManager Nav

@if (Auth.Current == null)
{
    Nav.NavigateTo("/login");
    return;
}

<div>
    <header class="topbar">
        <div class="brand">
            <img src="logo.png" alt="Logo" class="logo-img sm" />
            <div>
                <div class="logo-title">GRAB & LOG</div>
                <div class="logo-sub">TOOL ROOM 5.1</div>
            </div>
        </div>
        <div class="user">
            <span>@Auth.Current.Name</span>
            <div class="avatar">@Auth.Initials</div>
        </div>
    </header>
    <div class="layout">
        <aside class="sidebar">
            <nav>
                <button class="nav-btn" @onclick='() => Nav.NavigateTo("/inventory")'><span>📦</span> Inventory</button>
                <button class="nav-btn" @onclick='() => Nav.NavigateTo("/logs")'><span>📋</span> Activity Logs</button>
                <button class="nav-btn" @onclick='() => Nav.NavigateTo("/registry")'><span>🚨</span> Control Registry</button>
                <button class="nav-btn active"><span>👥</span> Operator Registry</button>
            </nav>
        </aside>
        <main class="content">
            <h2>Operator Registry</h2>
            <p style="color:var(--muted);margin-top:8px">Manage operator accounts and terminal access.</p>
        </main>
    </div>
</div>
