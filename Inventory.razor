@page "/inventory"
@inject AuthService Auth
@inject ToolService Tools
@inject NavigationManager Nav

@if (Auth.Current == null) { Nav.NavigateTo("/login"); return; }

<div>
  <header class="topbar">
    <div class="brand">
      <img src="logo.png" class="logo-img sm" alt="Logo" />
      <div><div class="logo-title">GRAB & LOG</div><div class="logo-sub">TOOL ROOM 5.1</div></div>
    </div>
    <div class="user">
      <span>@Auth.Current.Name</span>
      <div class="avatar">@Auth.Initials</div>
    </div>
  </header>
  <div class="layout">
    <aside class="sidebar">
      <nav>
        <button class="nav-btn active" @onclick='() => Nav.NavigateTo("/inventory")'>📦 Inventory</button>
        <button class="nav-btn" @onclick='() => Nav.NavigateTo("/registry")'>🚨 Control Registry</button>
      </nav>
      <div class="sidebar-foot">ADMIN MODE · SYSTEM</div>
    </aside>
    <main class="content">
      <div class="panel-top">
        <div class="tabs">
          <button class="tab @(filter=="all"?"active":"")" @onclick='() => filter="all"'>All Tools</button>
          <button class="tab @(filter=="available"?"active":"")" @onclick='() => filter="available"'>Available</button>
          <button class="tab @(filter=="inuse"?"active":"")" @onclick='() => filter="inuse"'>In Use</button>
          <button class="tab @(filter=="overdue"?"active":"")" @onclick='() => filter="overdue"'>Overdue</button>
        </div>
        <div class="online"><span class="dot"></span> SYSTEM ONLINE</div>
      </div>
      <div class="cards">
        @foreach (var t in Tools.Filter(filter)) {
          <div class="card">
            <div class="card-top">
              <div><div class="card-id">@t.Id</div><div class="card-name">@t.Name</div></div>
              <div class="card-icon">@t.Icon</div>
            </div>
            <span class="badge @t.Status">@Label(t.Status)</span>
            <div class="card-meta">
              <div>STORAGE LOCATION</div>
              <div class="val">@t.Location</div>
              @if (!string.IsNullOrEmpty(t.LoggedTo)) { <div style="margin-top:5px">LOGGED: @t.LoggedTo</div> }
            </div>
            @if (t.Status=="available") {
              <button class="btn-borrow" @onclick="() => Borrow(t.Id)">BORROW TOOL</button>
            } else if (t.Status is "inuse" or "overdue") {
              <button class="btn-return" @onclick="() => Return(t.Id)">RETURN</button>
            } else {
              <button class="btn-sm" disabled>UNAVAILABLE</button>
            }
          </div>
        }
      </div>
    </main>
  </div>
</div>

@code {
  string filter = "all";
  void Borrow(string id) { Tools.Borrow(id, Auth.Current!.Name); }
  void Return(string id) { Tools.Return(id); }
  static string Label(string s) => s switch {
    "available"=>"AVAILABLE","inuse"=>"IN USE","overdue"=>"OVERDUE","disposed"=>"DISPOSED",_=>s.ToUpper()
  };
}
