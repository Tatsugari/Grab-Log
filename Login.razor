@page "/login"
@inject AuthService Auth
@inject NavigationManager Nav
@inject ToolService Tools

<div class="auth-screen">
    <div class="auth-card">
        <div class="hazard-stripe"></div>
        <div class="auth-logo">
            <img src="logo.png" alt="Logo" class="logo-img" />
            <div>
                <div class="logo-title">GRAB & LOG</div>
                <div class="logo-sub">TOOL ROOM 5.1</div>
            </div>
        </div>

        <h1>Welcome back</h1>
        <p class="auth-desc">Sign in with your work email and PIN to unlock the tool room, inventory, and your next shift.</p>

        <label>OPERATOR EMAIL</label>
        <input type="email" @bind="email" placeholder="you@company.com" />

        <label>PIN / PASSWORD</label>
        <div class="pin-wrap">
            <span>🔒</span>
            <input type="password" @bind="pin" placeholder="••••••••" />
        </div>
        <p class="help">Need help? Ask your supervisor for your PIN or reset access.</p>

        <button class="btn-yellow" @onclick="SignIn">Sign in to inventory</button>

        <div class="auth-links">
            New operator? Create a terminal access request and your supervisor will invite you to the tool room.<br />
            <a href="#" @onclick="OpenRegister" @onclick:preventDefault>Register terminal access</a>
        </div>
    </div>
</div>

@if (showRegister)
{
    <div class="modal-backdrop" @onclick="CloseRegister">
        <div class="modal-box" @onclick:stopPropagation>
            <h3 style="margin-bottom:6px">Register terminal access</h3>
            <p class="modal-desc">Create your operator profile.</p>

            <label>FULL NAME</label>
            <input type="text" @bind="regName" placeholder="Your full name" />

            <label>WORK EMAIL</label>
            <input type="email" @bind="regEmail" placeholder="you@company.com" />

            <label>PIN / PASSWORD</label>
            <input type="password" @bind="regPin" placeholder="Create a PIN" />

            <div class="modal-btns" style="margin-top:18px">
                <button class="btn-ghost" @onclick="CloseRegister">Cancel</button>
                <button class="btn-yellow" style="width:auto;padding:8px 16px" @onclick="SubmitRegister">Submit request</button>
            </div>
        </div>
    </div>
}

@code {
    string email = "";
    string pin = "";
    bool showRegister;
    string regName = "", regEmail = "", regPin = "";

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("email", out var q))
            email = q.ToString();
    }

    void SignIn()
    {
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(pin)) return;
        Auth.Login(email, pin);
        Nav.NavigateTo("/inventory");
    }

    void OpenRegister() => showRegister = true;
    void CloseRegister() => showRegister = false;

    void SubmitRegister()
    {
        if (Auth.Register(regName, regEmail, regPin))
        {
            email = regEmail;
            pin = regPin;
            showRegister = false;
        }
    }
}
